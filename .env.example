# Copy to .env and fill in. Never commit .env.
# Used by docker-compose.yml for Postgres + backend + frontend.

# --- Database ---
POSTGRES_DB=canteen
POSTGRES_USER=canteen
POSTGRES_PASSWORD=changeme_strong_password

# --- Backend ---
# Spring profile: postgres profile connects to db service, h2 is local default
SPRING_PROFILES_ACTIVE=postgres
JWT_SECRET=change_me_to_a_very_long_random_string_min_32_chars
JWT_EXPIRATION_MS=86400000
# Seeded demo admin (change in production!)
ADMIN_ID=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Canteen Admin
ADMIN_EMAIL=admin@college.edu

# --- Frontend (build-time) ---
# For local Vite dev (without docker) use http://localhost:8080
# For docker-compose production the nginx proxy forwards /api -> backend,
# so VITE_API_URL can be empty (same-origin).
VITE_API_URL=
